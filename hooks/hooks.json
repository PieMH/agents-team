{
  "description": "agents-team context gate: holds new subagent spawns once the orchestrator's context passes the run's threshold",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/context-gate.mjs"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
